# Copy this file to `.env` locally (do NOT commit secrets).
# Example backend environment variables for deployment (replace values):

# Database
DB_USERNAME=neondb_owner
DB_PASSWORD=YOUR_DB_PASSWORD
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-twilight-term-az69lea2-pooler.c-3.ap-southeast-1.aws.neon.tech:5432/neondb?sslmode=require&channelBinding=require&socketTimeout=30
# Optional always-on warm pool (do NOT set on Railway Serverless — blocks sleep):
# HIKARI_MINIMUM_IDLE=2
# HIKARI_IDLE_TIMEOUT=600000
# HIKARI_KEEPALIVE_TIME=120000
# HIKARI_TCP_KEEPALIVE=true
# Optional deadline reminder (default hourly; false disables the in-process job):
# APP_DEADLINE_REMINDER_ENABLED=true
# APP_DEADLINE_REMINDER_FIXED_RATE_MS=3600000

# Frontend — set per environment (also used as fallback reset-link base when Origin header is absent)
# Local:  FRONTEND_URL=http://localhost:5173
# Render: FRONTEND_URL=https://oop-autograder.vercel.app
FRONTEND_URL=https://oop-autograder.vercel.app

# Mail — local dev uses Gmail SMTP; Render free tier blocks SMTP so use Brevo HTTPS API in production
# Local (smtp):
MAIL_PROVIDER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=projectg5741@gmail.com
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
MAIL_FROM=projectg5741@gmail.com

# Render free tier (brevo) — sign up at https://www.brevo.com, verify sender email, create API key
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-...   # API keys tab — NOT xsmtpsib- (SMTP key)
# MAIL_FROM=projectg5741@gmail.com

# Global API burst guard (web profile only; ignored on desktop). Defaults match application.properties.
# APP_BURST_MAX_REQUESTS=5
# APP_BURST_MAX_READS=30
# APP_BURST_MAX_AUTH_REQUESTS=30
# APP_BURST_WINDOW_SECONDS=10
# APP_BURST_RETRY_AFTER_SECONDS=5

# Security — HS256 signing key, at least 32 bytes. Startup fails if missing or too short.
# Generate a local value: openssl rand -base64 32
# Do not commit real production secrets.
JWT_SECRET=replace_this_with_a_strong_secret_at_least_32_chars

# Google
GOOGLE_CLIENT_ID=901862485743-on3umlivpedse7hosvjtjqdpqr57s69i.apps.googleusercontent.com

# OpenAPI / Swagger — local default is enabled (leave unset or true). Production: false.
# SPRINGDOC_ENABLED=false

# Docker/Railway/Render — image entrypoint: `exec java $JAVA_OPTS -jar app.jar`.
# `mvn spring-boot:run` ignores it. Do not set -Xmx512m: the API and worker share one cgroup.
# Default matches backend/Dockerfile (metaspace + code-cache caps for small hosts).
JAVA_OPTS=-Xmx256m -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=48m -XX:+ExitOnOutOfMemoryError

# Optional: local dev with heavier lecturer concurrency (cloud default is 5).
# HIKARI_MAXIMUM_POOL_SIZE=10
# Sleep-friendly Hikari defaults live in application.properties (min-idle 0, keepalive off).

# Submission storage
SUBMISSION_BASE_DIR=submissions

# Container sandbox (stage 3) — testcase invoke only; default off preserves local worker.jar
SANDBOX_ENABLED=true
SANDBOX_RUNNER_URL=http://localhost:8090
SANDBOX_RUNNER_TOKEN=replace_with_shared_secret

# Local only (relative to backend/ for mvn spring-boot:run). Do NOT set this on Render/Docker —
# the image ships /app/worker.jar and sets WORKER_JAR accordingly. A local target/... value on
# Render resolves to /app/target/... and breaks operational testcases.
WORKER_JAR=target/backend-1.0.0-worker.jar

# Desktop student practice pack export (lecturer Term Management). Base64 PKCS#8 Ed25519 private key;
# must pair with backend/src/main/resources/desktop-pack-public.key (replace both in production).
# DESKTOP_PACK_SIGNING_PRIVATE_KEY=MC4CAQAwBQYDK2VwBCIEIDkzhyy+Z04+u6tsG4rb/qesP7orwumt08BUPG0SZWwz

# Student dashboard: offline practice folder download (fixed path, no env)
# Assemble (repo root): .\scripts\assemble-student-desktop.ps1 -OutputDir dist\StudentPractice
# → writes backend/target/OOP-AutoGrader-Practice.zip (local) or place OOP-AutoGrader-Practice.zip next to app.jar (Docker)
# Runtime-only (no .agpack); lecturers distribute packs separately.